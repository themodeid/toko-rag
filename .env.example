# =============================================================================
# TOKO ONLINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini ke .env di root project, lalu sesuaikan nilainya:
#   npm run env:init
# =============================================================================

NODE_ENV=development

# --- Ports (host) ---
BACKEND_PORT=5000
FRONTEND_PORT=4000
POSTGRES_PORT=5453
REDIS_PORT=6381

# --- Host labels ---
APP_PUBLIC_HOST=localhost
FRONTEND_PUBLIC_HOST=localhost

# --- PostgreSQL ---
POSTGRES_DB=toko_online_adam
POSTGRES_USER=adam_dev
POSTGRES_PASSWORD=adamwahyukur

# --- Backend (local / be/.env) ---
PORT=5000
DATABASE_URL=postgresql://adam_dev:adamwahyukur@localhost:5453/toko_online_adam
REDIS_URL=redis://localhost:6381
CORS_ORIGIN=http://localhost:4000,http://localhost:3000
JSON_BODY_LIMIT=10mb
STARTUP_RETRIES=30
STARTUP_DELAY_MS=2000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
DB_WAIT_ATTEMPTS=30

# --- JWT Configuration ---
JWT_SECRET=super_secret_jwt_key_toko_online_adam
JWT_EXPIRES_IN=1d

# --- Backend (Docker internal — dipakai docker-compose) ---
DATABASE_URL_DOCKER=postgresql://adam_dev:adamwahyukur@postgres-db:5432/toko_online_adam
REDIS_URL_DOCKER=redis://redis:6379

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
INTERNAL_API_URL=http://backend:5000/api

# --- Docker service names ---
POSTGRES_CONTAINER_NAME=postgres-db-main
REDIS_CONTAINER_NAME=redis-toko-online
BACKEND_CONTAINER_NAME=backend-api
FRONTEND_CONTAINER_NAME=frontend-app
